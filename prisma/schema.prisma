generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  email         String   @unique
  password_hash String
  is_admin      Boolean  @default(false)
  admin_role    String?  // null | "escalerilla" | "reservas" | "all"
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  player                Player?
  password_reset_tokens PasswordResetToken[]

  @@map("users")
}

model Player {
  id               String    @id @default(uuid())
  user_id          String    @unique
  name             String
  email            String    @unique
  phone            String?
  avatar_url       String?
  position         Int?
  wins             Int       @default(0)
  losses           Int       @default(0)
  total_matches    Int       @default(0)
  immune_until     DateTime?
  vulnerable_until DateTime?
  member_type      String    @default("socio")
  parent_id        String?
  has_debt         Boolean   @default(false)
  created_at       DateTime  @default(now())
  extra_high_demand_slots   Int       @default(0)
  school_names  String[]  @default([])
  // Slug de la temporada cuyo resumen de cierre ya vio (el modal no se repite).
  // Server-side a propósito: localStorage se pierde al cambiar de dispositivo.
  last_summary_seen String?

  // No-respuestas acumuladas (desafíos que dejó vencer sin contestar). A la 2ª
  // baja al último de su categoría, y de ahí en adelante una categoría por vez.
  // Se reinicia al jugar un partido de verdad: el castigo apunta a quien se
  // ausenta seguido, no a quien falló una vez hace meses.
  no_response_count Int @default(0)

  // Última victoria por W.O. Para que otro W.O. le cuente necesita 3 partidos
  // jugados de verdad después de esta fecha; así nadie escala a punta de
  // rivales que no contestan.
  last_wo_win_at DateTime?

  // Tiene pendiente su partido de ingreso: elige un rival de la escalerilla y
  // si gana toma su puesto, si pierde entra último. Se activa al crear un socio
  // nuevo y al reincorporar a quien se había retirado; se apaga al jugarlo.
  entry_match_available Boolean @default(false)

  // Cuenta dada de baja: el socio desaparece de la app (no aparece en listados
  // ni puede entrar) pero su fila sigue viva y CON SU NOMBRE, para que los
  // partidos que jugó se sigan leyendo en el fixture y en el historial de sus
  // rivales. Borrarlo de verdad se llevaría esos desafíos también para ellos.
  deactivated_at DateTime?

  user     User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent   Player? @relation("family", fields: [parent_id], references: [id])
  children Player[] @relation("family")

  challenges_made      Challenge[]         @relation("challenger")
  challenges_received  Challenge[]         @relation("challenged")
  ranking_history      RankingHistory[]
  master_group_players MasterGroupPlayer[]
  master_matches_p1    MasterMatch[]       @relation("master_player1")
  master_matches_p2    MasterMatch[]       @relation("master_player2")
  master_matches_won   MasterMatch[]       @relation("master_winner")
  reservations         Reservation[]
  notifications        Notification[]
  achievements         PlayerAchievement[]
  season_standings     SeasonStanding[]

  @@map("players")
}

model Challenge {
  id              String    @id @default(uuid())
  challenger_id   String
  challenged_id   String
  /// "normal" = desafío de escalerilla · "entry" = partido de ingreso, el que
  /// juega quien entra o vuelve a la escalerilla (ver challenge-rules).
  type            String    @default("normal")
  status          String    @default("pending")
  accept_deadline DateTime
  play_deadline   DateTime
  scheduled_date  DateTime?
  created_at      DateTime  @default(now())
  accepted_at     DateTime?
  first_result_at DateTime?
  played_at       DateTime?
  resolved_at     DateTime?
  winner_id       String?
  final_score     String?

  challenger_result Json?
  challenged_result Json?
  results_match     Boolean?

  challenger Player @relation("challenger", fields: [challenger_id], references: [id])
  challenged Player @relation("challenged", fields: [challenged_id], references: [id])

  @@index([status])
  @@index([challenger_id])
  @@index([challenged_id])
  @@map("challenges")
}

model RankingHistory {
  id           String   @id @default(uuid())
  player_id    String
  position     Int
  old_position Int?
  created_at   DateTime @default(now())
  reason       String?

  player Player @relation(fields: [player_id], references: [id])

  @@index([player_id])
  @@map("ranking_history")
}

model PasswordResetToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  used       Boolean  @default(false)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model MasterSeason {
  id                String    @id @default(uuid())
  name              String
  /// Temporada de la escalerilla a la que pertenece el cuadro. Sin esto la
  /// página del Master mostraba siempre el más reciente que existiera, aunque
  /// fuera del semestre pasado.
  season_id         String?
  category          String
  status            String    @default("pending")
  round_robin_start DateTime?
  round_robin_end   DateTime?
  final_date        DateTime?
  created_at        DateTime  @default(now())

  season  Season?       @relation(fields: [season_id], references: [id])
  groups  MasterGroup[]
  matches MasterMatch[]

  @@index([season_id])
  @@map("master_seasons")
}

model MasterGroup {
  id         String   @id @default(uuid())
  season_id  String
  name       String
  created_at DateTime @default(now())

  season  MasterSeason        @relation(fields: [season_id], references: [id], onDelete: Cascade)
  players MasterGroupPlayer[]
  matches MasterMatch[]       @relation("group_matches")

  @@map("master_groups")
}

model MasterGroupPlayer {
  id         String   @id @default(uuid())
  group_id   String
  player_id  String
  wins       Int      @default(0)
  losses     Int      @default(0)
  sets_won   Int      @default(0)
  sets_lost  Int      @default(0)
  created_at DateTime @default(now())

  group  MasterGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  player Player      @relation(fields: [player_id], references: [id])

  @@unique([group_id, player_id])
  @@map("master_group_players")
}

model MasterMatch {
  id             String    @id @default(uuid())
  group_id       String?
  season_id      String
  round          String
  player1_id     String
  player2_id     String
  winner_id      String?
  score          String?
  player1_result Json?
  player2_result Json?
  status         String    @default("pending")
  scheduled_date DateTime?
  played_at      DateTime?
  created_at     DateTime  @default(now())

  season       MasterSeason  @relation(fields: [season_id], references: [id], onDelete: Cascade)
  group        MasterGroup?  @relation("group_matches", fields: [group_id], references: [id])
  player1      Player        @relation("master_player1", fields: [player1_id], references: [id])
  player2      Player        @relation("master_player2", fields: [player2_id], references: [id])
  winner       Player?       @relation("master_winner", fields: [winner_id], references: [id])
  reservations Reservation[] @relation("match_reservations")

  @@map("master_matches")
}

model Court {
  id         String   @id @default(uuid())
  name       String
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  reservations Reservation[]
  blocks CourtBlock[]

  @@map("courts")
}

model Reservation {
  id             String    @id @default(uuid())
  player_id      String
  court_id       String
  date           DateTime  @db.Date
  time_slot      String
  is_high_demand Boolean   @default(false)
  has_guest      Boolean   @default(false)
  guest_name     String?
  guest_paid     Boolean   @default(false)
  guest_fee      Int       @default(0)
  partner_name   String?
  status         String    @default("active")
  cancelled_at   DateTime?
  cancel_reason  String?
  created_at     DateTime  @default(now())
  is_challenge     Boolean   @default(false)
  challenge_id     String?
  is_master        Boolean   @default(false)
  master_match_id  String?
  school_name      String?

  player       Player       @relation(fields: [player_id], references: [id])
  court        Court        @relation(fields: [court_id], references: [id])
  master_match MasterMatch? @relation("match_reservations", fields: [master_match_id], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([player_id, status])
  @@index([challenge_id])
  @@map("reservations")
}

model SystemConfig {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @default(now())

  @@map("system_config")
}
model CourtBlock {
  id         String   @id @default(uuid())
  court_id   String
  date       DateTime @db.Date
  time_slot  String?
  reason     String?
  created_at DateTime @default(now())

  court Court @relation(fields: [court_id], references: [id])

  @@map("court_blocks")
}

model LightChargeConfig {
  id              String   @id @default(uuid())
  date            DateTime @db.Date
  time_slots      String[] @default([])
  amount_per_slot Int      @default(3000)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@unique([date])
  @@map("light_charge_configs")
}

model Notification {
  id           String   @id @default(uuid())
  player_id    String
  type         String
  title        String
  body         String
  read         Boolean  @default(false)
  action_label String?
  action_path  String?
  created_at   DateTime @default(now())

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@index([player_id, read])
  @@index([player_id, created_at])
  @@map("notifications")
}

/// Temporada de la escalerilla (semestre). El cierre congela un SeasonStanding
/// por jugador; la apertura registra su posición inicial.
model Season {
  id         String    @id @default(uuid())
  slug       String    @unique // "2026-1"
  name       String // "Escalerilla 2026 · 1er Semestre"
  status     String    @default("active") // active | closed
  started_at DateTime  @default(now())
  closed_at  DateTime?

  /// Rangos de categoría con los que se jugó (ver common/ladder.ts).
  /// "legacy4" = 4 categorías sobre 48 puestos, hasta el 1er semestre 2026.
  /// "v2" = 3 categorías sin tope, desde el 2do semestre 2026.
  /// Guardarlo evita reetiquetar el histórico al cambiar los rangos.
  category_scheme String @default("v2")

  standings      SeasonStanding[]
  master_seasons MasterSeason[]

  @@map("seasons")
}

/// Foto del jugador en una temporada: posición inicial, posición final,
/// récord congelado y resultado del cuadro Master de esa temporada.
model SeasonStanding {
  id             String  @id @default(uuid())
  season_id      String
  player_id      String
  start_position Int?
  final_position Int?
  wins           Int     @default(0)
  losses         Int     @default(0)
  total_matches  Int     @default(0)
  category       String? // A | B | C | D al cierre
  master_result  String? // champion | finalist | semifinalist

  season Season @relation(fields: [season_id], references: [id], onDelete: Cascade)
  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([season_id, player_id])
  @@index([player_id])
  @@map("season_standings")
}

/// Logro desbloqueado. El catálogo vive en código (achievements.catalog.ts):
/// agregar un logro nuevo no requiere migración.
/// `season_slug` usa el centinela "global" en vez de NULL porque en Postgres
/// los NULL son distintos entre sí y el @@unique no impediría duplicados.
model PlayerAchievement {
  id          String   @id @default(uuid())
  player_id   String
  code        String
  season_slug String   @default("global")
  context     Json?
  unlocked_at DateTime @default(now())
  seen        Boolean  @default(false)

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)

  @@unique([player_id, code, season_slug])
  @@index([player_id, seen])
  @@map("player_achievements")
}
